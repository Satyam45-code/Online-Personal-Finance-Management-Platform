<%@ page import="com.finance.model.User,com.finance.dao.UserDAO,java.util.*" %>
<%@ page contentType="text/html;charset=UTF-8" %>
<% User user=(User)session.getAttribute("user"); if(user==null||!"ADMIN".equals(user.getRole())){response.sendRedirect("login.jsp");return;} List<User> users=new UserDAO().findAll(); %>
<!DOCTYPE html><html><head><title>Admin | Finora</title><link rel="stylesheet" href="css/style.css"></head><body><div class="layout">
<div class="sidebar"><div class="brand">Fin<span>ora</span></div><div class="nav"><a class="active" href="admin.jsp">⌂ Admin Dashboard</a><a href="logout">⇥ Logout</a></div></div>
<div class="main"><div class="topbar"><div><h1>Admin Control Center</h1><div class="muted">Users, security and system oversight.</div></div><div class="userpill">ADMIN</div></div>
<%if(request.getParameter("msg")!=null){%><div class="alert"><%=request.getParameter("msg")%></div><%}%>
<div class="grid"><div class="card"><div class="stat"><%=users.size()%></div><div class="label">Total users</div></div><div class="card"><div class="stat">ON</div><div class="label">Encryption</div></div><div class="card"><div class="stat">ON</div><div class="label">Access control</div></div><div class="card"><div class="stat">INR</div><div class="label">Currency</div></div></div>
<div class="two"><div class="card"><h2>User Management</h2><table><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr><%for(User u:users){%><tr><td><%=u.getName()%></td><td><%=u.getEmail()%></td><td><span class="tag"><%=u.getRole()%></span></td><td><%=u.getStatus()%></td><td><a class="btn danger" href="admin/user?id=<%=u.getId()%>">Delete</a></td></tr><%}%></table></div>
<div class="card"><h2>Create user</h2><form action="admin/user" method="post"><input name="name" placeholder="Full name" required><input name="email" type="email" placeholder="Email" required><input name="password" placeholder="Password" required><select name="role"><option>USER</option><option>ADMIN</option></select><button class="btn">Create user</button></form></div></div>
<div class="three"><div class="card"><h2>🔐 Data Security</h2><p class="muted">Encryption enabled</p><p class="muted">Access controls enabled</p><p class="muted">Login security enabled</p><button class="btn light">Security settings</button></div><div class="card"><h2>⚙ System Settings</h2><p class="muted">Application: Finora</p><p class="muted">Currency: INR</p><p class="muted">Notifications: Enabled</p><button class="btn light">System settings</button></div><div class="card"><h2>📊 Reports</h2><p class="muted">Account activity and security overview.</p><button class="btn light">View reports</button></div></div>
</div></div></body></html>
